# Secrets — private SSH key for the bundled Server Files feature.
# NEVER commit the plaintext key. Only the README and the ENCRYPTED backup are tracked.
secrets/*
!secrets/README.md
!secrets/id_rsa.enc
id_rsa
id_ed25519

# IDE
.idea/
*.swp
*.swo
*~
.vscode/

# Distribution
*.dmg
*.zip
*.pkg

# web backend access token (generated per deployment; never commit)
server/.token
server/.env.local
server/tls/
server/.env

# Build output and dependencies
server/target/
web/node_modules/
web/dist/
# verify:static 的截图默认落在 web/ 下（脚本没传目录时），是调试产物
web/static-*.png

# Fetched by web/scripts/fetch-assets.sh, not authored here. Version-pinned in
# that script, so a checkout reproduces them exactly.
web/public/scrcpy-server
web/public/icon-helper.apk

# Bridge build output and the downloadable binaries staged for the server
bridge/target/
server/bridge-dist/

# 服务端的共享密钥（本仓库不应出现任何真实凭据）
server/.token
server/.env

# wrangler 的本地构建缓存
.wrangler/

# 本地 Function 的环境变量（DIAG_TOKEN 之类）。线上用 wrangler pages secret put。
.dev.vars

# cf CLI 的构建产物与账号缓存（含账号 ID 和邮箱，公开仓库不能带）
.cloudflare/
