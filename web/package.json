{
  "name": "adb-studio-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "assets": "bash scripts/fetch-assets.sh",
    "verify:bridge": "node scripts/verify-bridge.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "seo:submit": "bash scripts/submit-indexnow.sh",
    "test": "node scripts/test-image-extract.mjs",
    "verify:auto": "node scripts/verify-autoconnect.mjs",
    "verify:logcat": "node scripts/verify-logcat.mjs http://127.0.0.1:7070",
    "verify:netcapture": "node scripts/verify-netcapture.mjs",
    "verify:net": "node scripts/verify-net.mjs http://127.0.0.1:7070",
    "verify:perf": "node scripts/verify-perf.mjs http://127.0.0.1:7070",
    "verify:keyboard": "node scripts/verify-keyboard.mjs http://127.0.0.1:7070",
    "verify:help": "node scripts/verify-help.mjs",
    "verify:local-bridge": "node scripts/verify-local-bridge.mjs",
    "verify:transport": "node scripts/verify-transport-auto.mjs",
    "test:apk": "node scripts/test-apk-parse.mjs",
    "test:install": "node scripts/test-install-choice.mjs",
    "verify:root": "node scripts/verify-root-reconnect.mjs"
  },
  "dependencies": {
    "@yume-chan/adb": "^2.6.2",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/android-bin": "^2.1.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.6.1",
    "protobufjs": "^8.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/w3c-web-usb": "^1.0.14",
    "@vitejs/plugin-react": "^6.0.5",
    "puppeteer-core": "^24.43.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
